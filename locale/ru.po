msgstr "Сеть акведуков ещё не готова"

msgid "There is no spring on this hex"
msgstr "На этом гексе нет источника"

msgid "Requires the \"Concrete\" technology"
msgstr "Требуется технология «Бетон»"

msgid "This spring is already connected to the city"
msgstr "Этот источник уже соединён с городом"

msgid "Aqueduct to the city"
msgstr "Акведук к городу"

