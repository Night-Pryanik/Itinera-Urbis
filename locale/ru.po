msgctxt "professions.description"
msgid "A pseudo-profession that covers the whole population of the city, including employed citizens."
msgstr "Псевдо-профессия: охватывает всё население города, включая занятых жителей."

msgctxt "professions.description"
msgid "Burns wood into charcoal."
msgstr "Обжигает древесину в древесный уголь."

msgctxt "professions.description"
msgid "Copies and studies texts in the library and scriptorium, adding to the city's science."
msgstr "Переписывает и исследует тексты в библиотеке и скриптории, пополняя пул науки."

msgctxt "professions.description"
msgid "Cultivates the vineyard and gathers the harvest."
msgstr "Возделывает виноградник, собирает урожай."

msgctxt "professions.description"
msgid "Cuts wet turf from the bog and stacks it to dry into fuel."
msgstr "Режет сырой торф на болоте и складывает его сушиться на топливо."

msgctxt "professions.description"
msgid "Description of brewer profession."
msgstr "Описание профессии варщика."

msgctxt "professions.description"
msgid "Description of oilmaker profession."
msgstr "Описание профессии маслодела."

msgctxt "professions.description"
msgid "Description of winemaker profession."
msgstr "Описание профессии винодела."

msgctxt "professions.description"
msgid "Digs and sorts clay for firing."
msgstr "Копает и сортирует глину для обжига."

msgctxt "professions.description"
msgid "Digs ore and minerals out of the ground."
msgstr "Добывает руду и минералы под землёй."

msgctxt "professions.description"
msgid "Extracts soda from natural deposits."
msgstr "Добывает соду из природных отложений."

msgctxt "professions.description"
msgid "Extracts stone from open quarries."
msgstr "Добывает камень в открытых карьерах."

msgctxt "professions.description"
msgid "Feeds the poultry and the small livestock kept under a roof."
msgstr "Кормит птицу и мелкий скот, которых держат под крышей."

msgctxt "professions.description"
msgid "Fells trees in forest plots and hauls in the timber."
msgstr "Рубит деревья на лесной делянке и заготавливает древесину."

msgctxt "professions.description"
msgid "Fishes from boats on any water body with a dock."
msgstr "Ловит рыбу с лодок на водоёмах с пристанью."

msgctxt "professions.description"
msgid "Fits staves into barrels and seals them with tar."
msgstr "Собирает клёпки в бочки и запечатывает их смолой."

msgctxt "professions.description"
msgid "Forges tools, weapons and ornaments from metal."
msgstr "Кует инструменты, оружие и украшения из металла."

msgctxt "professions.description"
msgid "Frames, planks and rigs wooden boats."
msgstr "Собирает набор, обшивает досками и оснащает деревянные лодки."

msgctxt "professions.description"
msgid "Gathers and boils down natural tar."
msgstr "Собирает и выпаривает природную смолу."

msgctxt "professions.description"
msgid "Grinds aromatic resins into perfumes and incense."
msgstr "Стирает ароматические смолы в духи и благовония."

msgctxt "professions.description"
msgid "Grinds grain between millstones and tends the mill."
msgstr "Мелет зерно на жерновах и следит за работой мельницы."

msgctxt "professions.description"
msgid "Grows technical and spice crops."
msgstr "Возделывает технические и пряные культуры."

msgctxt "professions.description"
msgid "Limes, scrapes and dries hides into parchment."
msgstr "Обрабатывает известью, скоблит и сушит шкуры в пергамент."

msgctxt "professions.description"
msgid "Makes dyes from natural materials."
msgstr "Изготавливает красители из природных материалов."

msgctxt "professions.description"
msgid "Saws timber into planks and shapes wood for construction and crafts."
msgstr "Пилит брёвна на доски и обрабатывает дерево для строительства и ремёсел."

msgctxt "professions.description"
msgid "Sews the sheets into books and glues the spine under a leather cover."
msgstr "Сшивает листы в книги и проклеивает корешок под кожаным переплётом."

msgctxt "professions.description"
msgid "Shapes and fires clay into pots, bricks and tablets."
msgstr "Формует и обжигает глину в горшки, кирпичи и таблички."

msgctxt "professions.description"
msgid "Smelts ore into pure metals."
msgstr "Плавит руду в чистые металлы."

msgctxt "professions.description"
msgid "Strains plant fibers into sheets of paper."
msgstr "Отливает растительные волокна в листы бумаги."

msgctxt "professions.description"
msgid "Tans hides and sews leather goods."
msgstr "Дубит шкуры и шьёт кожаные изделия."

msgctxt "professions.description"
msgid "Tends the herd and keeps count of the livestock."
msgstr "Присматривает за стадом, следит за поголовьем."

msgctxt "professions.description"
msgid "Tends the hives and harvests honey."
msgstr "Следит за ульями, собирает мёд."

msgctxt "professions.description"
msgid "Tends the pigs and keeps the sty in order."
msgstr "Ходит за свиньями и держит свинарник в порядке."

msgctxt "professions.description"
msgid "Turns sand and soda into glass."
msgstr "Превращает песок и соду в стекло."

msgctxt "professions.description"
msgid "Weaves cloth, clothes and carpets from fibers."
msgstr "Ткёт ткани, одежду и ковры из волокон."

msgctxt "professions.description"
msgid "Weaves, cuts and treats heavy sailcloth for boats and mills."
msgstr "Ткёт, кроит и пропитывает плотную парусину для лодок и мельниц."

msgctxt "professions.description"
msgid "Works the fields and tends the crops."
msgstr "Возделывает поля, ухаживает за посевами."

msgctxt "professions.description"
msgid "Tends the still and draws strong spirits and rectified spirit from fermented drinks and sweet mashes."
msgstr "Следит за перегонным кубом и выгоняет крепкие напитки и спирт-ректификат из сброженных напитков и сладкого сусла."

msgctxt "professions.description"
msgid "Distils acids, solvents and reagents in retorts and alembics."
msgstr "Перегоняет кислоты, растворители и реактивы в ретортах и аламбиках."

msgctxt "professions.description"
msgid "Cuts stones and works precious metals into jewelry."
msgstr "Ограняет камни и выделывает украшения из благородных металлов."

msgctxt "professions.description"
msgid "Boils oils, alkali and resin into soap."
msgstr "Варит мыло из масел, щёлочи и смолы."

msgctxt "professions.description"
msgid "Crafts furniture and luxury furniture from timber."
msgstr "Изготавливает из древесины обычную и роскошную мебель."

msgctxt "professions.description"
msgid "Dips and moulds tallow and beeswax into candles."
msgstr "Макает и отливает свечи из животного жира и пчелиного воска."

msgctxt "professions.description"
msgid "Dresses rough stone into ashlar blocks, tableware and mortar."
msgstr "Обтёсывает камень в строительные блоки и посуду и готовит раствор."

msgctxt "professions.description"
msgid "Cures and smokes fish over slow wood fires."
msgstr "Засаливает и коптит рыбу на медленном древесном дыму."

