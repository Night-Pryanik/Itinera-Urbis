msgstr "Городка больше нет на карте"

msgid "The town pays %s more"
msgstr "Городок платит на %s больше"

msgid "The town pays %s more for %s"
msgstr "Городок платит на %s больше за %s"

msgid "The towns know what the city is good at."
msgstr "Городки знают, чем славен город."

msgid "The widest coastal strip, in hexes."
msgstr "Самая широкая полоса берега, в гексах."

msgid "The window: %s"
msgstr "Окно задачи: %s"

msgid "The world has learned the name of the goods of the city."
msgstr "Мир узнал названия товаров города."

msgid "Theme: Blueprint"
msgstr "Тема: чертёж"

msgid "Theme: Bronze"
msgstr "Тема: бронза"

msgid "Theme: Classic"
msgstr "Тема: классическая"

msgid "Theme: Dusk"
msgstr "Тема: сумерки"

