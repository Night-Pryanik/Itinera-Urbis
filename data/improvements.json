{
  // IMPORTANT: the farm / pasture / farmstead / pigsty / beehive / vineyard /
  // plantation improvements work in TWO modes (see docs.md, the section
  // "Breeding animals and plants (crop_bred scheme)"):
  //   1) The hex ALREADY has a natural resource (the improved_by field points
  //      to this improvement in data/resources/*.json). The build keeps
  //      tile.resource, and the quality is the current one.
  //   2) The hex is empty — the player breeds a domesticated species. The id
  //      of the animal/plant is written to tile.crop_bred, tile.resource stays
  //      null. The quality is inherited from an already domesticated specimen
  //      of that species.
  // PRODUCTION: an improvement with a worker outputs the "produces" of its
  // resource (or the wood yield of the cover) as a continuous stream — the
  // value from the data is a rate of units per second. The simulation tick is
  // SIMULATION_TICK = 1 sec (CityData.SIMULATION_TICK, the step in main_map.gd),
  // so a produces of 10 means 10 units every second. Feed (feed_consumption)
  // is written off at the same continuous per-second rate.
  "improvements": [
    {
      "id": "farm",
      "name": "Farm",
      "icon": "farm.png",
      "color": [ 255, 255, 0 ],
      "work_cost": 8,
      "maintenance_cost": 0.2,
      "unlock_tech": "farming",
      // The farm works the MAIN FOOD PLANTS only — the crops of
      // data/resources/plants/food_plants.json. No animals (they have the
      // pasture, the farmstead and the pigsty) and no technical or auxiliary
      // crops (the plantation): the farm is what feeds the city, and the
      // "Plow" bonus applies to it alone. Both improvements grow plants, so
      // both take the fresh-water bonus (data/modifiers.json).

      // The profession of the worker on this improvement. The label is set/cleared
      // automatically in worker_manager.gd on assignment/dismissal.
      "profession": "farmer",
      // A conductor of fresh water: after the technology "Irrigation" is
      // researched, the farm spreads fresh water to neighbouring hexes
      // (the water_access scheme: chain).
      "conducts_water": true,
      "flavor": "Wherever grains were first domesticated — in the river valleys of South Asia, in the Americas, in the Near East — the same operation appeared: break the soil and return seed to it. A farm does not change the land; it gives a settled community a dependable way to work the food plants already growing there."
    },
    {
      "id": "pasture",
      "name": "Pasture",
      "icon": "pasture.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 25,
      "maintenance_cost": 100.0,
      "unlock_tech": "animal_husbandry",
      "profession": "herder",
      "flavor": "Keeping herds on open land is older than permanent fields. From the steppes of Central Asia to the savannas of Africa and the pampas of South America, herders learned to follow the grasses rather than sow them. A pasture fixes that wandering practice in one place and makes it part of the town's economy."
    },
    {
      "id": "farmstead",
      "name": "Farmstead",
      "icon": "farmstead.png",
      "color": [ 190, 122, 53 ],
      // Confined small livestock (poultry, pigeons, rabbits) is housed here
      // instead of on a pasture: a fenced grazing area is the wrong label for a
      // coop or a hutch, and the label is the whole reason the improvement
      // exists (docs.md, "Improvement types are a convention"). The output is
      // the same as on a pasture — neither has production modifiers — so the
      // difference is a cheaper construction and another worker.
      "work_cost": 12,
      "maintenance_cost": 100.0,
      "unlock_tech": "animal_husbandry",
      "profession": "stockman",
      "flavor": "Not every domesticated animal can live on a range. Poultry, pigeons and rabbits do better in an enclosed yard, and a fenced homestead describes their place better than a grazing field. The small enclosure gives a household meat and manure without a larger territory."
    },
    {
      "id": "pigsty",
      "name": "Pigsty",
      "icon": "pigsty.png",
      "color": [ 168, 112, 60 ],
      // Pigs are kept in a sty, not grazed on a range — the same reasoning as the
      // farmstead (docs.md, "Improvement types are a convention"). No production
      // modifiers, so the output of the pigs is unchanged: the difference is the
      // construction and the worker.
      "work_cost": 16,
      "maintenance_cost": 100.0,
      "unlock_tech": "animal_husbandry",
      "profession": "swineherd",
      "flavor": "Pigs were domesticated independently in several regions and are kept close to the dwelling rather than driven to pasture. A sty keeps them out of the crops and turns household scraps into meat and fertilizer. It is a small structure with a large return."
    },
    {
      "id": "mine",
      "name": "Mine",
      "icon": "mine.png",
      "color": [ 105, 105, 105 ],
      "work_cost": 30,
      "maintenance_cost": 36.0,
      "unlock_tech": "mining",
      "profession": "miner",
      "flavor": "The first mines followed veins visible at the surface; deeper workings waited on timber supports, drainage and reliable lighting. Knowledge of rock and ore passed from master to apprentice in every mining region, from the Andes to the Urals and the hills of East Asia. A mine is where that knowledge becomes a lasting source of metal."
    },
    {
      "id": "quarry",
      "name": "Quarry",
      "icon": "quarry.png",
      "color": [ 139, 137, 137 ],
      "work_cost": 20,
      "maintenance_cost": 36.0,
      "unlock_tech": "masonry",
      "profession": "quarryman",
      "flavor": "Stone is the oldest building material that does not rot. A quarry supplies the blocks for walls, roads and foundations, and its workers learn to read the grain of the rock before they cut it. Unlike a mine, it works at the surface and needs no shafts."
    },
    {
      "id": "beehive",
      "name": "Apiary",
      "icon": "beehive.png",
      "color": [ 255, 215, 0 ],
      "work_cost": 12,
      "maintenance_cost": 100.0,
      "unlock_tech": "beekeeping",
      "profession": "beekeeper",
      "flavor": "Beekeeping is known from many ancient societies, from the Nile valley to the forests of Eastern Europe and the islands of the Pacific. Keepers learned to move hives to the flowering season instead of chasing wild swarms. The apiary turns the blossoms of the whole neighbourhood into honey and wax without taking the land out of other use."
    },
    {
      "id": "vineyard",
      "name": "Vineyard",
      "icon": "vineyard.png",
      "color": [ 128, 0, 0 ],
      "work_cost": 35,
      "maintenance_cost": 54.0,
      "unlock_tech": "winegrowing",
      "profession": "vinedresser",
      "flavor": "Grapes grow readily in many climates and were pressed long before the plant was given rows and trellises. A vineyard fixes the crop in one place, so the harvest can be timed and its quality watched from year to year. The same fruit is eaten fresh or fermented, and the two uses compete for one harvest."
    },
    {
      "id": "clay_pit",
      "name": "Clay Pit",
      "icon": "clay_pit.png",
      "color": [ 210, 180, 140 ],
      "work_cost": 22,
      "maintenance_cost": 27.0,
      "unlock_tech": "pottery",
      "profession": "clay_digger",
      "flavor": "Pottery appears wherever clay, water and fire meet, and it begins without a stone kiln. The pit supplies the earth; the potter decides what it becomes. Because clay is heavy and fragile in transit, the potter's house is almost always built beside the pit."
    },
    {
      "id": "peat_pit",
      "name": "Peat Pit",
      "icon": "peat_pit.png",
      "color": [ 92, 64, 42 ],
      "work_cost": 22,
      "maintenance_cost": 27.0,
      "unlock_tech": "peat_cutting",
      "profession": "peat_cutter",
      "flavor": "In cold wetlands, dead plant matter accumulates faster than it decays and forms peat. It can be cut by hand, dried and burned, and it served as fuel wherever wood was scarce. A peat pit is a mine of a different kind: its ore is the slow growth of a bog."
    },
    {
      "id": "plantation",
      "name": "Plantation",
      "icon": "plantation.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 28,
      "maintenance_cost": 54.0,
      "unlock_tech": "plantations",
      "profession": "planter",
      // A conductor of fresh water: after the technology "Irrigation" is
      // researched, the plantation spreads fresh water to neighbouring hexes
      // (the water_access scheme: chain). As a grower of plants it also takes
      // the fresh-water production bonus itself.
      "conducts_water": true,
      "flavor": "Crops such as sugarcane, cotton and tea need a long season and a steady labour force. A plantation gathers them on one estate and processes them near the field, because the raw plants lose value quickly after harvest. Once irrigation is understood, the same estate can carry water to its neighbours."
    },
    {
      "id": "tar_pit",
      "name": "Tar Pit",
      "icon": "tar_pit.png",
      "color": [ 139, 69, 19 ],
      "work_cost": 30,
      "maintenance_cost": 81.0,
      "unlock_tech": "tar_burning",
      "profession": "tar_collector",
      "flavor": "Tar and pitch were known wherever coniferous forests grew: the resin was heated until it ran and then used to seal boats and roofs. Burning it in a pit is a simple operation, but it needs a steady supply of wood and a worker who knows when to stop the fire. The product is a waterproof layer that outlasts the timber it protects."
    },
    {
      "id": "soda_quarry",
      "name": "Soda Quarry",
      "icon": "soda_quarry.png",
      "color": [ 200, 220, 255 ],
      "work_cost": 30,
      "maintenance_cost": 72.0,
      "unlock_tech": "soda_extraction",
      "profession": "soda_extractor",
      "flavor": "Natural soda was gathered from dry lake beds and alkaline springs long before factories made it. It serves in washing, in glassmaking and in the preparation of food. A soda quarry is the place where those deposits are concentrated enough to be worked."
    },
    {
      "id": "salt_pond",
      "name": "Salt Pond",
      "icon": "salt_pond.png",
      "color": [ 255, 255, 200 ],
      "work_cost": 30,
      "maintenance_cost": 32.4,
      "unlock_tech": "salt_extraction",
      "flavor": "Where the sun is strong and the sea or a salt lake is near, a shallow pond makes salt by evaporation alone. No fire and no machinery are needed — only a basin, a season and patience. Salt preserves food, and a dependable pond frees the town from distant mines."
    },
    {
      "id": "spring_catchment",
      "name": "Spring Catchment",
      "icon": "spring_catchment.png",
      "color": [ 63, 148, 145 ],
      "work_cost": 22,
      "maintenance_cost": 46.8,
      "unlock_tech": "masonry",
      "profession": "water_drawer",
      "flavor": "A spring is a small but dependable gift, easily muddied by people and animals. A catchment built around it guards the water and lets it be drawn in quantity. The masonry is simple, yet it is what turns a trickle into a supply the town can count on."
    },
    {
      // The harbor — the "key" to the water resources of a specific body of water.
      // It is built on an EMPTY coastal hex (land next to lake/sea) via the
      // control panel. After the build, all resources of that body of water
      // (found by flood-fill over the water, see MapHelpers.has_harbor_access)
      // become available for exploitation: improvements with the requires_harbor
      // flag can be built on them (currently — fishing_boats). Each body of
      // water needs its OWN harbor. Access is computed dynamically (BFS over
      // water), so when the harbor is demolished the resources of that body of
      // water become unavailable for NEW builds once again.
      // PROFESSIONS AND WORKERS: ordinary improvements have the "profession"
      // field — the id of the worker's profession (see data/professions.json).
      // In addition, the "no_worker": true field marks an improvement as
      // INFRASTRUCTURE: it does not require a worker to perform its functions
      // (workers cannot be assigned, and there are no "Start/Pause work" buttons
      // in the panel).
      "id": "harbor",
      "name": "Harbor",
      "icon": "harbor.png",
      "color": [ 139, 90, 43 ],
      "work_cost": 25,
      "maintenance_cost": 0.4,
      "unlock_tech": "fishing",
      // Infrastructure: it opens the water resources of the body of water by
      // itself, no worker is required (see docs.md, "Professions and
      // resource consumption").
      "no_worker": true,
      // Marker: this improvement opens the water resources of its body of water.
      "water_body_harbor": true,
      "flavor": "A harbor is not a shelter for one ship but a claim on a whole body of water. Once the quay exists, every shoal and landing place on that lake or sea becomes reachable, and each body of water needs its own. The harbor itself needs no worker: it is the place from which other workers set out."
    },
    {
      // Fishing boats — catch fish. They can be built ONLY on hexes with a fish
      // resource belonging to a body of water that has a harbor (see the
      // water_body_harbor flag on the harbor and has_harbor_access in
      // map_helpers.gd).
      "id": "fishing_boats",
      "name": "Fishing Boats",
      "icon": "fishing_boats.png",
      "color": [ 70, 130, 180 ],
      "work_cost": 15,
      "maintenance_cost": 45.0,
      "unlock_tech": "fishing",
      "profession": "fisherman",
      // Marker: a harbor on this same body of water is required for the build.
      "requires_harbor": true,
      "no_road": true,
      "flavor": "Fishing boats extend the town beyond the shoreline. They can be used only where a harbor already gives access to the water, for a boat needs somewhere to land and a community to mend it. The catch comes from the water rather than the field, so the boats belong to a different economy than the farm."
    },
    {
      // Irrigation canal: an infrastructure conductor improvement unlocked by
      // the technology "Canals". It distributes fresh water to neighbours
      // (conducts_water) in the "by chain" mode (is_canal): the chain of water
      // goes through canals just as through farms/plantations, with the range
      // limit from tech_modifiers.
      "id": "irrigation_canal",
      "name": "Irrigation Canal",
      "icon": "irrigation_canal.png",
      "color": [ 0, 191, 255 ],
      "work_cost": 20,
      "maintenance_cost": 0.4,
      "unlock_tech": "canals",
      "conducts_water": true,
      "is_canal": true,
      "no_worker": true,
      // A road to a canal is NOT laid: this is an infrastructure element,
      // and extending a road network to it makes no sense.
      "no_road": true,
      "flavor": "Canals are among the oldest pieces of infrastructure: a dug channel carries water further than anyone can carry a bucket. Once a chain of canals exists, water passes from one field to the next and every farm along it benefits. The canal needs no worker of its own — its work is done by gravity."
    },
    {
      // The woodcutter's camp — a logging improvement. It works in TWO modes
      // (both branches are supported, no code change is needed for future
      // resources):
      //   1) ON A WOOD RESOURCE: if the hex has a raw resource with
      //      improved_by == "lumberjack_hut" (future cedar, oak, tulipwood,
      //      Paulownia and so on), the camp extracts it as an ORDINARY
      //      improvement via the common flow (tile.resource + produces) and
      //      outputs the specific product of that resource (redwood, ship timber,
      //      dyes, etc.). For that it is enough to set
      //      improved_by == "lumberjack_hut" in data/resources/*.json.
      //   2) ON AN EMPTY FOREST HEX: if there is no resource but the cover
      //      gives timber (wood_yield > 0 in data/covers.json), the camp outputs
      //      ordinary "Wood" derived from the density of the cover: sparse forest
      //      — 1, continuous forest — 2. Any future forest cover with
      //      wood_yield > 0 will fit without a code change.
      //      It is built on an empty DRY hex (not a swamp, not marsh, not water).
      // Implementation: calculation/crediting is in main_map.gd (the production
      // tick), availability/preview is in control_panel.gd and map_tooltip.gd.
      "id": "lumberjack_hut",
      "name": "Woodcutter's Camp",
      "icon": "lumberjack_hut.png",
      "color": [ 101, 67, 33 ],
      "work_cost": 18,
      "maintenance_cost": 90.0,
      "unlock_tech": "wood_processing",
      "profession": "lumberjack",
      "flavor": "A camp in the forest is among the first workshops of a settled community. Where a valuable tree grows, the camp takes that timber; where the forest is ordinary, it cuts wood by the density of the stand. It does not clear the land for good — it follows the forest as it regrows."
    }
  ]
}
