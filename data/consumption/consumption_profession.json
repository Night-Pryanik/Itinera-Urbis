{
  // A registry of occupational resource consumption.
  //
  // It describes what the worker professions consume on the map improvements
  // and in the city buildings, and how often (see docs.md, the section
  // "Professions and resource consumption").
  // The "profession ↔ resource" link is set via the "profession" field.
  //
  // The target resource ("resource") can be:
  //   * an id of a single product from data/products/*.json — for example, "tools";
  //   * a reference to a product group from data/product_groups/ in the format
  //     "@<group_id>" — for example, "@boats" (the "Boats" group). In that case
  //     ANY suitable product from the group is written off: first the total
  //     stock across all group members is summed, then the list is drawn
  //     greedily from the available members (quality priority "best"). While the sum
  //     over the group covers "amount" — the bonus applies; if not — the bonus
  //     is removed and the improvement keeps working on the base multiplier.
  //
  // Entry format:
  //   resource          — the product id or the group "@id" (as in craft recipes).
  //   profession        — an array of profession ids that consume the resource
  //                       (data/professions.json). Several professions may
  //                       consume the same resource.
  //   amount            — how many units are written off per one "consumption tick".
  //   interval          — the period between write-offs in seconds (fractions allowed).
  //   production_bonus  — an addition to the production multiplier of the object
  //                       while the resource is enough in storage. 0.5 = +50% (x1.5).
  //                       The bonuses of SINGLE entries add up to each other,
  //                       while among GROUP ones the best available one is taken (just one):
  //                       the "Boats" group gives the bonus of the best of the
  //                       available members, not of all of them at once.
  //                       It does not apply to the pseudo-profession "all" (0.0):
  //                       city consumption gives no bonus at all.
  //
  // Duplicating declarations: if the same resource is described both here and in
  // a product (data/products/*.json, the "consumption" field) for one profession,
  // the entry from this file takes priority; the duplicate entry is ignored.
  // "Resource-side" consumption is left for the single cases where a product
  // has no analogue or assembling a group is not reasonable.
  //
  // A resource listed both here and for the pseudo-profession "all"
  // (consumption_all.json) is written off ONCE: the professions of this file have
  // priority, and their citizens are subtracted from the headcount of the "all"
  // rule for the same resource. The professionals keep the production bonus of
  // their rule; the "all" rule gives no bonus.
  "consumption": [
    {
      "resource": "@boats",
      "profession": [ "fisherman" ],
      "amount": 10,
      "interval": 30,
      "production_bonus": 0.5
    },
    {
      "resource": "writing_set",
      "profession": [ "scientist" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.25
    },
    {
      "resource": "@tare",
      "profession": [ "winemaker", "brewer", "oilmaker", "distiller", "perfumer" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.25
    },
    {
      // Sulfur preserves the drink and the oil while they stand in the vessel and
      // bleaches the cloth in finishing, therefore the one rule covers both the
      // professions that consume tare and the weaver.
      "resource": "sulfur",
      "profession": [ "winemaker", "brewer", "oilmaker", "weaver" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      "resource": "alum",
      "profession": [ "dyer" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      // Sulfuric acid consumption by metallurgists: a boost to production while
      // sulfuric acid is available in storage, representing its use in metal
      // refining, pickling, and other metallurgical processes.
      "resource": "sulfuric_acid",
      "profession": [ "smelter", "blacksmith" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.15
    },
    {
      // Work tools are a consumable for everyone who digs, fells, mines or shapes: the
      // rule covers any instrument from the @instruments group, taken greedily from the
      // cheapest member available (copper first, steel last).
      "resource": "@instruments",
      "profession": [ 
        "miner",
        "quarryman",
        "lumberjack",
        "farmer",
        "planter",
        "clay_digger",
        "potter",
        "vinedresser",
        "blacksmith",
        "furniture_maker"
      ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.25
    },
    {
      // Glue holds the crafts of the shaped material and of the written word together: the
      // tanner glues the tanned hide, the carpenter and the furniture maker glue the timber,
      // the potter joins and finishes the fired clay, the paper and parchment makers size
      // their sheets with it, and the bookbinder glues the spine of the book.
      "resource": "glue",
      "profession": [
        "tanner",
        "potter",
        "carpenter",
        "furniture_maker",
        "paper_maker",
        "parchment_maker",
        "bookbinder"
      ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      // The cooper seals the barrel with tar: the staves hold the vessel together, but only
      // the coating makes it watertight.
      "resource": "tar",
      "profession": [ "cooper" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      // Alchemists use rectified spirit as a clean lamp fuel and general extraction solvent.
      "resource": "rectified_spirit",
      "profession": [ "alchemist" ],
      "amount": 10,
      "interval": 15,
      "production_bonus": 0.15
    },
    {
      // Turpentine protects and dresses worked timber for carpenters and furniture makers
      // and dissolves oils and stains in the dyer's workshop.
      "resource": "turpentine",
      "profession": [ "carpenter", "furniture_maker", "dyer" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      // Rosin pitches barrels inside, enriches soap lather, sizes paper sheets against
      // ink bleed and serves as soldering flux at the forge.
      "resource": "rosin",
      "profession": [ "cooper", "soap_maker", "paper_maker", "blacksmith" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    },
    {
      // Clear varnish seals finished furniture, woodwork and bound book covers.
      "resource": "spirit_varnish",
      "profession": [ "furniture_maker", "carpenter", "bookbinder" ],
      "amount": 10,
      "interval": 15,
      "production_bonus": 0.15
    },
    {
      // White naphtha feeds hot, soot-free lamps for glassmakers and alchemists and
      // degreases hides in the tannery.
      "resource": "white_naphtha",
      "profession": [ "glassmaker", "alchemist", "tanner" ],
      "amount": 10,
      "interval": 15,
      "production_bonus": 0.15
    },
    {
      // Mercury extracts gold and silver from ore by amalgamation and coats ornaments
      // in fire-gilding.
      "resource": "mercury",
      "profession": [ "smelter", "jeweler" ],
      "amount": 10,
      "interval": 15,
      "production_bonus": 0.2
    },
    {
      // Hydrochloric acid pickles scale from forged metal, leaches ores, cleans and
      // parts precious metals for the jeweler, and brightens mordant dyes.
      "resource": "hydrochloric_acid",
      "profession": [ "smelter", "blacksmith", "jeweler", "dyer" ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.15
    },
    {
      // Coca is the stimulant of hard manual labour: the leaf sharpens the
      // worker and lifts his output by a tenth. The rule covers extraction,
      // felling, furnace work and field work. Citizens of these professions are
      // excluded from the "all" coca rule, so the leaf is not spent twice; the
      // rate per worker matches the one per resident there.
      "resource": "coca_leaf",
      "profession": [
        "miner",
        "quarryman",
        "clay_digger",
        "soda_extractor",
        "lumberjack",
        "charcoal_burner",
        "tar_collector",
        "smelter",
        "blacksmith",
        "farmer",
        "planter",
        "vinedresser"
      ],
      "amount": 10,
      "interval": 10,
      "production_bonus": 0.1
    }
  ]
}