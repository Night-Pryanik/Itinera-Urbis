      "resource": "millstone",
      "profession": [ "miller", "oilmaker" ],
      "buildings": [ "animal_mill", "water_mill", "windmill", "oilmaker_house", "oil_mill" ],
      "amount": 10,
      "interval": 30,
      "production_bonus": 0.15
    },
    {
      // Dried bog turf fires pottery and brick kilns, heats malt and brew kettles,
      // boils soap pans and cures fish over slow smoke where firewood is scarce.
      "resource": "peat",
      "profession": [ "potter", "brewer", "soap_maker", "smoker" ],
      "amount": 10,
      "interval": 15,
      "production_bonus": 0.05
    },
    {
      // Mineral coal feeds hot, steady fires under pottery kilns, glass pots, brew
