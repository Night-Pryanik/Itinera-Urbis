{
  // A part of the registry of product groups: the goods that stand for one another wherever a good of
  // the data may be named. A group is addressed as "@<id>" — by the ingredient of a craft recipe, by
  // the resource of a consumption rule, by the goods a specialization bonus acts on.
  //
  // The registry is split by the mechanic that reads it, and this file holds the lines of prestige a
  // specialization branch pays for (see data/specializations.json). These groups cover whole product
  // lines, including their branded goods, for price and production bonuses; a fame tier may also use
  // the same group to count sales.
  // The identifier of a group is global, so a group lives in exactly one file even when a second
  // mechanic names it; the file of that mechanic says so.
  //
  // The optional "icon" field of a group — the icon file name shown wherever the group itself is
  // drawn as a resource: the card and tooltip on the "Trade" tab, the group rows and the headers of a
  // composition list. If it is not specified, the icon of the FIRST member of the group that has its
  // own icon is taken; a group needs its own icon where that member does not speak for the group.
  //
  // A member of "products" may be "@<id>" of another group instead of a good: the loader replaces it
  // with that group's members. A group must not nest in itself, directly or through other groups.
  "product_groups": [
    {
      "id": "fabric_clothing_goods",
      "name": "Cloth Clothes",
      "products": [ "fabric_clothes", "branded_fabric_clothes" ]
    },
    {
      "id": "wool_clothing_goods",
      "name": "Wool Clothes",
      "products": [ "wool_clothes", "branded_wool_clothes" ]
    },
    {
      "id": "leather_clothing_goods",
      "name": "Leather Clothes",
      "products": [ "leather_clothes", "morocco_leather_clothes", "branded_leather_clothes" ]
    },
    {
      "id": "cheese_goods",
      "name": "Cheese",
      "products": [ "cheese", "aged_cheese" ]
    },
    {
      "id": "ceramics_goods",
      "name": "Ceramics",
      "products": [ "pottery", "bricks", "amphora", "porcelain", "fine_ceramics", "clay_tablets" ]
    },
    {
      // The branch of the smiths is a branch of blades of every metal the forge knows, not of the bar,
      // so the group is the weapons and not the iron. A weapon of a metal the data adds later joins
      // the line only when it is written here: nothing derives the list from the "weapons" category.
      "id": "weapons_goods",
      "name": "Weapons",
      "products": [
        "copper_weapons",
        "bronze_weapons",
        "iron_weapons",
        "steel_weapons",
        "damascus_weapons"
      ]
    },
    {
      // The branch of the distillers is a branch of every strong spirit the data knows, not of the
      // brandy alone: the @spirits list of the consumption rules names the distilled drinks the
      // cellars hold, and the brand the fame of the brandy opens joins the line with it.
      "id": "spirits_goods",
      "name": "Strong Spirits",
      "products": [
        "@spirits",
        "city_brandy"
      ]
    }
  ]
}
