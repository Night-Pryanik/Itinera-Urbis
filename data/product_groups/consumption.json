{
  // A part of the registry of product groups: the goods that stand for one another wherever a good of
  // the data may be named. A group is addressed as "@<id>" — by the ingredient of a craft recipe, by
  // the resource of a consumption rule, by the goods a specialization bonus acts on.
  //
  // The registry is split by the mechanic that reads it, and this file holds the groups a consumption
  // rule writes off — the key "@<id>" of the "resource" field in data/consumption/ (see
  // scripts/consumption_manager.gd). The identifier of a group is global, so a group lives in exactly
  // one file even when a second mechanic names it; the file of that mechanic says so.
  //
  // The optional "icon" field of a group — the icon file name shown wherever the group itself is
  // drawn as a resource: the card and tooltip on the "Trade" tab, the group rows and the headers of a
  // composition list. If it is not specified, the icon of the FIRST member of the group that has its
  // own icon is taken; a group needs its own icon where that member does not speak for the group.
  "product_groups": [
    {
      "id": "boats",
      "name": "Boats",
      "products": [ "reed_boat" ]
    },
    {
      "id": "fruits",
      "name": "Fruits",
      "products": [
        "grapes",
        "olives",
        "mulberries",
        "figs",
        "dates",
        "coconuts",
        "cactus_fruit",
        "agave",
        "pomegranates",
        "yucca_fruit",
        "carob_pods",
        "apples"
      ]
    },
    {
      // Nuts are a group of their own although the warehouse shelf already
      // separates them from fruits: one consumption rule writes off one group,
      // so pooling the two would let a town pay the same demand out of either
      // harvest. Walnuts stand in "@tannins" as well — the nut is eaten and is
      // a tanning material at once, and the two demands compete for it.
      "id": "nuts",
      "name": "Nuts",
      "products": [ "walnuts", "pistachio", "beech_nuts" ]
    },
    {
      // The fermented drinks the city empties. The recipes of vinegar and rectified spirit take
      // the same list, keeping distilled spirits apart.
      "id": "alcohol",
      "name": "Alcohol",
      "products": [ "beer", "mead", "sake", "pulque", "toddy", "wine", "fruit_wine", "hopped_beer", "carob_wine", "cider" ]
    },
    {
      // Distilled spirits stand apart from fermented "@alcohol" so they are never spent on
      // vinegar or rectification and can be toggled independently on the domestic market.
      // The order is the write-off order: everyday spirits go first, cordial last.
      "id": "spirits",
      "name": "Strong Spirits",
      "products": [
        "arkhi",
        "mezcal",
        "arrack",
        "grain_spirit",
        "honey_spirit",
        "fruit_brandy",
        "brandy",
        "cordial"
      ]
    },
    {
      "id": "non_alcoholic_beverages",
      "name": "Beverages",
      "products": [ "tea", "coffee", "cocoa", "mate", "karkadeh" ]
    },
    {
      // Ordered from everyday vessels to luxury service so common pottery and glassware
      // are written off before porcelain, crystal and silver plate.
      "id": "tableware",
      "name": "Tableware",
      "products": [
        "pottery",
        "stone_tableware",
        "glassware",
        "fine_ceramics",
        "porcelain",
        "metal_tableware",
        "crystal_glassware",
        "silver_tableware"
      ]
    },
    {
      "id": "jewelry",
      "name": "Jewelry",
      "products": [
        "gold_jewelry",
        "silver_jewelry",
        "steel_jewelry",
        "brass_jewelry",
        "bronze_jewelry",
        "iron_jewelry",
        "lazurite_jewelry",
        "malachite_jewelry",
        "nephrite_jewelry",
        "porphyry_jewelry",
        "copper_jewelry",
        "glass_jewelry",
        "pearl_jewelry",
        "coral_jewelry"
      ]
    },
    {
      "id": "clothes",
      "name": "Clothes",
      "products": [
        "wool_clothes",
        "fabric_clothes",
        "leather_clothes",
        "silk_clothes"
      ]
    },
    {
      "id": "spices",
      "name": "Spices",
      "products": [
        //"black_pepper",
        "sesame",
        "cinnamon",
        //"cloves",
        "nutmeg",
        "saffron",
        "vanilla",
        "chili",
        "sumac"
      ]
    },
    {
      "id": "sweeteners",
      "name": "Sweeteners",
      "products": [ "sugar", "honey", "carob_syrup" ]
    },
    {
      "id": "aux_food",
      "name": "Additional Food",
      "products": [ "eggs", "oyster" ]
    },
    {
      // Everyday household supplies; glue and white naphtha stand last so common goods
      // cover domestic demand first before drawing down workshop consumables.
      "id": "consumer_goods",
      "name": "Consumer Goods",
      "products": [ "salt", "soap", "vegetable_oil", "sponge", "glue", "white_naphtha" ]
    },
    {
      // The empty vessel a good is stored and shipped in. Tare is generic: the winemaker, brewer,
      // oilmaker, distiller and perfumer ask for any container, not one tied to a single drink or oil.
      "id": "tare",
      "name": "Tare",
      "products": [ "amphora", "glass_bottle", "wooden_barrel" ]
    },
    {
      // The goods of the perfumer's art as the citizens use them: floral water, oil
      // perfume, incense, attar and alcohol-based fragrant spirit. Raw resins, blossoms
      // and intermediate essential oils (sandalwood oil, chamomile oil) are NOT in the
      // group: citizens buy finished goods, not workshop feedstocks.
      // The order of the members is the write-off order: accessible floral water and
      // everyday perfume go first, costly attar and fragrant spirit last.
      "id": "perfumery",
      "name": "Perfumery",
      "products": [ "floral_water", "perfume", "incense", "attar", "spirit_perfume" ]
    },
    {
      // Work tools: the pick of the miner and quarryman, the axe of the lumberjack,
      // the hoe of the farmer and planter, the shovel of the clay digger and the vinedresser,
      // the chisel of the mason. The order is the write-off order: basic copper tools go first,
      // fine steel ones last — workers take whatever is available in storage.
      "id": "instruments",
      "name": "Instruments",
      "products": [ "copper_tools", "bronze_tools", "brass_tools", "iron_tools", "steel_tools" ]
    },
    {
      // Furniture the citizens write off: the everyday piece goes first,
      // the costly one last.
      "id": "furniture",
      "name": "Furniture",
      "products": [ "furniture", "luxury_furniture" ]
    },
    {
      // Domestic candles: everyday tallow candles go first so cleaner beeswax candles
      // last longer in storage.
      "id": "candles",
      "name": "Candles",
      "products": [ "tallow_candles", "wax_candles" ]
    }
  ]
}
