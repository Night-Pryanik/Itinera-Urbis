{
  // A part of the registry of product groups: the goods that stand for one another wherever a good of
  // the data may be named. A group is addressed as "@<id>" — by the ingredient of a craft recipe, by
  // the resource of a consumption rule, by the goods a specialization bonus acts on.
  //
  // The registry is split by the mechanic that reads it, and this file holds the groups a recipe
  // accepts in place of one another: the key "@<id>" in the "resources" of a craft means "any good of
  // the group" (see scripts/craft_container.gd). The identifier of a group is global, so a group lives
  // in exactly one file even when a second mechanic names it; the file of that mechanic says so.
  //
  // The optional "icon" field of a group — the icon file name shown wherever the group itself is
  // drawn as a resource: the card and tooltip on the "Trade" tab, the group rows and the headers of a
  // composition list. If it is not specified, the icon of the FIRST member of the group that has its
  // own icon is taken; a group needs its own icon where that member does not speak for the group.
  //
  // A member of "products" may be "@<id>" of another group instead of a good: the loader replaces it
  // with that group's members. A group must not nest in itself, directly or through other groups.
  "product_groups": [
    {
      "id": "bovines",
      "name": "Bovines",
      "products": [
        "live_cows",
        "live_zebu",
        "live_banteng",
        "live_buffalo",
        "live_bison",
        "live_yak"
      ],
      "icon": "cows.png"
    },
    {
      // Everything the mill grinds into the flour of the city: the grain
      // crops and the pod of the carob tree, which is ground into a flour of
      // its own kind — but the mill has one flour.
      "id": "millable_grains",
      "name": "Grains and Pods",
      "products": [
        "wheat",
        "rye",
        "barley",
        "oats",
        "corn",
        "rice",
        "millet",
        "sorghum",
        "buckwheat",
        // The pod is milled into flour as well, and the flour is the flour of
        // the mill: a dried sweet pod has no flour of its own.
        "carob_pods"
      ]
    },
    {
      "id": "tableware_stones",
      "name": "Tableware Stones",
      "products": [
        "alabaster",
        "nephrite",
        "porphyry",
        "basalt",
        "tuff",
        "sandstone",
        "marble",
        "granite",
        "limestone",
        "soapstone"
      ]
    },
    {
      // Hard, gritty stones fit for grinding: softer stones like limestone, marble
      // and soapstone crumble into the flour instead of shearing the grain.
      "id": "millstones",
      "name": "Millstone Stones",
      "products": [
        "basalt",
        "sandstone",
        "granite"
      ]
    },
    {
      "id": "oil_crops",
      "name": "Oil Crops",
      "products": [
        "sunflower",
        "sesame",
        "rapeseed",
        "flax",
        "soybean",
        "olives",
        "kenaf",
        "beech_nuts",
        "coconuts"
      ]
    },
    {
      "id": "textile_crops",
      "name": "Textile Crops",
      "products": [ "cotton", "flax", "hemp", "jute", "ramie", "kenaf", "yucca" ]
    },
    {
      "id": "rope_fibers",
      "name": "Rope Fibers",
      "products": [ "hemp", "jute", "ramie", "sisal", "papyrus", "kenaf", "yucca", "velvetleaf", "coir" ]
    },
    {
      "id": "paper_fibers",
      "name": "Paper Fibers",
      "products": [ "mulberry_bark", "hemp", "ramie", "sisal", "kenaf", "yucca", "velvetleaf" ]
    },
    {
      // all sweet fruits that don't have their own specific fermentation drinks, like grape wine, pulque etc.
      "id": "wine_fruits",
      "name": "Fruits",
      "products": [
        "mulberries",
        "figs",
        "dates",
        "cactus_fruit",
        "pomegranates",
        "yucca_fruit"
      ]
    },
    {
      "id": "writing_materials",
      "name": "Writing Materials",
      "products": [
        "clay_tablets",
        "wax_tablets",
        "papyrus",
        "parchment",
        "silk",
        "paper",
        "book"
      ]
    },
    {
      "id": "writing_instruments",
      "name": "Writing Instruments",
      "products": [ "wood", "papyrus_plant", "feathers" ]
    },
    {
      "id": "bronze_alloys",
      "name": "Bronze Alloys",
      "products": [ "tin", "antimony", "arsenic" ]
    },
    {
      "id": "barrel_wood",
      "name": "Wood for Barrels",
      // The group is cooperage wood in general, not tight-cask oak only: beech,
      // pine and maple went to slack staves and to headings, and walnut is the
      // specialty timber a cooper splits where oak does not grow.
      "products": [ "oak_wood", "beech_wood", "chestnut_wood", "pine_wood", "maple_wood", "walnut_wood" ]
    },
    {
      // Tanning agents include both plant tannins and mineral salts.
      "id": "tannins",
      "name": "Tanning Agents",
      "products": [ "oak_bark", "chestnut_bark", "walnuts", "galls", "campeche_wood", "sumac_leaves", "quebracho_wood", "alum" ]
    },
    {
      // Precious hardwoods used for fine furniture: oak, maple, mahogany, rosewood and ebony.
      // The furniture maker takes whichever species is available in storage.
      "id": "precious_woods",
      "name": "Precious Woods",
      "products": [ "oak_wood", "maple_wood", "mahogany", "rosewood", "ebony" ]
    },
    {
      // Broadleaf species whose ash yields rich potassium carbonate when leached: beech, oak,
      // maple, chestnut and walnut. Generic forest wood and resinous conifers are excluded so
      // potash competes with cooperage and fine carpentry and never displaces natural soda lakes.
      "id": "potash_woods",
      "name": "Potash Hardwoods",
      "products": [ "chestnut_wood", "maple_wood", "beech_wood", "walnut_wood", "oak_wood" ]
    },
    {
      // Purified, low-sulfur solid carbon burned in smelters, bloomeries, blast furnaces,
      // forges, jewelers' crucibles, glass furnaces and high-heat retorts. Raw peat and raw
      // coal are excluded because ash, moisture and sulfur spoil bare metal; gunpowder,
      // incense and hardwood potash still ask for pure wood charcoal.
      "id": "smelting_fuel",
      "name": "Furnace Fuel",
      "products": [ "charcoal", "coke" ]
    }
  ]
}
