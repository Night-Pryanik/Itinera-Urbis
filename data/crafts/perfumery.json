{
  // The recipes of the perfumer's house. The materials are named directly and not through
  // the "@perfumery" group: that group holds the ready goods of the perfumer's art, and
  // a recipe that takes the group would make a perfume out of an attar.
  "crafts": [
    {
      "id": "perfume",
      "name": "Perfume",
      "produced_in": [ "perfumer_house" ],
      "resources": [ [ { "frankincense": 20 }, { "myrrh": 20 }, { "roses": 20 }, { "cinnamon": 20 } ], { "vegetable_oil": 10 } ],
      "result": { "perfume": 10 },
      "time": 5.0,
      "unlock_tech": "perfume_making",
      "description": "Dissolves the fragrant material in oil and keeps the scent in a jar."
    },
    {
      // Rose petals are a perfume material, but resins and sandalwood oil are burned on the hearth.
      "id": "incense",
      "name": "Incense",
      "produced_in": [ "perfumer_house" ],
      "resources": [ [ { "frankincense": 20 }, { "myrrh": 20 }, { "sandalwood_oil": 20 } ], { "charcoal": 10 } ],
      "result": { "incense": 10 },
      "time": 5.0,
      "unlock_tech": "perfume_making",
      "description": "Grinds a fragrant material with charcoal into a powder for the hearth."
    },
    {
      "id": "sandalwood_oil",
      "name": "Sandalwood Oil",
      "produced_in": [ "perfumer_house" ],
      "resources": { "sandalwood": 20 },
      "result": { "sandalwood_oil": 10 },
      "time": 8.0,
      "unlock_tech": "distillation",
      "description": "Distils fragrant oil from sandalwood heartwood."
    },
    {
      // The alembic concentrates the scent of the fragrant material into a small, valuable yield.
      // Cinnamon stays last so dedicated fragrant botanicals are spent before table spices.
      "id": "attar",
      "name": "Attar",
      "produced_in": [ "perfumer_house" ],
      "resources": [ [ { "frankincense": 20 }, { "myrrh": 20 }, { "roses": 20 }, { "chamomile": 20 }, { "cinnamon": 20 } ] ],
      "result": { "attar": 5 },
      "time": 8.0,
      "unlock_tech": "distillation",
      "description": "Distils the scent of the fragrant material into a pure oil."
    },
    {
      "id": "floral_water",
      "name": "Floral Water",
      "produced_in": [ "perfumer_house" ],
      "resources": [ [ { "roses": 20 }, { "chamomile": 20 } ] ],
      "result": { "floral_water": 10 },
      "time": 6.0,
      "unlock_tech": "distillation",
      "description": "Steam-distils rose petals or chamomile blossoms into fragrant floral water."
    },
    {
      "id": "chamomile_oil",
      "name": "Chamomile Oil",
      "produced_in": [ "perfumer_house" ],
      "resources": { "chamomile": 20 },
      "result": { "chamomile_oil": 5 },
      "time": 8.0,
      "unlock_tech": "distillation",
      "description": "Steam-distils deep-blue essential oil from chamomile blossoms."
    },
    {
      // Essential oils come before table spices in the alternatives list so the
      // perfumer uses workshop oils first and draws on spices only when needed.
      "id": "spirit_perfume",
      "name": "Fragrant Spirit",
      "produced_in": [ "perfumer_house" ],
      "resources": [
        { "rectified_spirit": 10 },
        [ { "sandalwood_oil": 10 }, { "chamomile_oil": 10 }, { "nutmeg": 10 }, { "vanilla": 10 }, { "saffron": 10 } ]
      ],
      "result": { "spirit_perfume": 10 },
      "time": 10.0,
      "unlock_tech": "distillation",
      "description": "Dissolves distilled oils or rare spices in rectified spirit to make a lasting perfume."
    }
  ]
}
