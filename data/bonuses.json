{
  // Diversity bonuses: a reward for keeping several kinds of a good in
  // circulation. A tier fires when at least "min_varieties" members of the
  // product group held at least one resident's ration in the storage at the
  // start of the tick and had some flow (production, purchase, craft, market,
  // construction) within the last ten ticks. Only the highest reached tier
  // applies; the value is a fraction (0.05 = +5%).
  //
  // "group_id" names an id from data/product_groups/. "bonus_type" says what
  // the bonus acts on; currently "construction_speed" is the only implemented
  // gameplay effect. The tiers are ordered from the smallest threshold to the largest.
  "product_group_bonuses": [
    {
      // Rough stone of several kinds in the storeyard speeds up every build,
      // even when the mason cuts only one of them.
      "group_id": "building_stone",
      "bonus_type": "construction_speed",
      "tiers": [
        { "min_varieties": 2, "value": 0.05 },
        { "min_varieties": 3, "value": 0.10 },
        { "min_varieties": 5, "value": 0.20 }
      ]
    },
    {
      // A varied diet: the bonus counts the kinds of meat the citizens can eat —
      // those in stock or arriving during the tick, not only the ones actually
      // eaten. The effect is displayed only for now.
      "group_id": "meat",
      "bonus_type": "food_variety",
      "tiers": [
        { "min_varieties": 2, "value": 0.05 },
        { "min_varieties": 3, "value": 0.10 },
        { "min_varieties": 5, "value": 0.20 }
      ]
    }
  ]
}
