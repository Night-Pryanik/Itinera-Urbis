# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Compiled catalogs. The game loads the .po itself (internationalization/locale/translations),
# so a .mo in the repository would only be a second, silently outdated copy of the same text.
*.mo

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
