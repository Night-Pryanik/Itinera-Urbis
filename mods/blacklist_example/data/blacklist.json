{
  // A blacklist mod removes entities instead of adding them. The key is the collection,
  // the value is the list of identifiers to remove from it.
  //
  // The identifiers belong to their collection: "wine" here is a RECIPE in "crafts" and a
  // PRODUCT in "resources" — two different entities that share a name, and both have to
  // be named. Inside one collection a repeated id changes nothing.
  //
  // The whole chain goes, because a building without its recipes produces nothing, a
  // recipe without its building or feedstock cannot run, and a product with no recipe left
  // has no source (fruit_brandy stays because its cider recipe needs no winemaking):
  //   winemaker_house -> wine, fruit_wine, carob_wine -> brandy, fruit_brandy
  //
  // The brand of the brandy line goes with the chain it is worked from: the prestige good
  // of the line is the work of the same recipes, and its recipe spends the same removed
  // wine, so it is removed as a recipe and as a product.
  "blacklist": {
    "buildings": [ "winemaker_house" ],
    "crafts": [ "wine", "fruit_wine", "carob_wine", "brandy", "fruit_brandy", "city_brandy" ],
    "resources": [ "wine", "fruit_wine", "carob_wine", "brandy", "city_brandy" ]
  }
}
